{% assign chapters = site.pages | where: 'lang', page.search_language %}
[
{% for chapter in chapters %}{
  "title": {{ chapter.title | jsonify }},
  "url": {{ chapter.url | relative_url | jsonify }},
  "body": {{ chapter.content | markdownify | strip_html | normalize_whitespace | jsonify }}
}{% unless forloop.last %},{% endunless %}{% endfor %}
]
